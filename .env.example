# --- Site ---
# Site origin for canonical / sitemap / OG URLs. Optional: on Vercel the production domain
# (VERCEL_PROJECT_PRODUCTION_URL) is used automatically. Set this only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# --- Database (Neon). On Vercel these come from the Neon integration; locally copy them from the Neon console. ---
# Pooled connection: used by the app at runtime.
DATABASE_URL=
# Direct connection: used by prisma migrate and the seed script.
DATABASE_URL_UNPOOLED=

# --- Admin ---
# Email of the admin account. The seed script creates this user as ADMIN.
ADMIN_EMAIL=

# --- Auth.js + GitHub OAuth (Week 5). Set in Vercel (Production); locally use a separate OAuth App. ---
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
